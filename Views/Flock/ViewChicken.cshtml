@model YourChickenGuide.Models.Chicken

@{
    ViewData["Title"] = "Chicken Details";
}
<div class="text-center">
    <h1 class="display-4">@Model.Legband_Id</h1>
    <p> <a asp-controller="Flock" asp-action="EditChicken" asp-route-id="@Model.Id" class="btn btn-link">Edit</a></p>
    <table class="table">
        <tr>
            <th>Breed</th>
            <td>@Model.Breed</td>
        </tr>
        <tr>
            <th>Color</th>
            <td>@Model.Color</td>
        </tr>
        <tr>
            <th>Sex</th>
            <td>@Model.Sex</td>
        </tr>
        <tr>
            <th>Hatch Date</th>
            <td>@Model.HatchDate.ToString("d")</td>
        </tr>

        <tr>
            <th>Notes</th>
            <td>@Model.Notes</td>
        </tr>
        <tr>
            <th>Status</th>
            <td>@Model.Status</td>
        </tr>
        <tr>
            <th>Mother</th>
            <td>
                @if (Model.Mother != null)
                {
                    <a asp-action="ViewChicken" asp-route-id="@Model.Mother.Id">
                        @Model.Mother.Legband_Id
                    </a>
                }
                else
                {
                    <span>Unknown</span>
                }
            </td>
        </tr>
        <tr>
            <th>Father</th>
            <td>
            @if (Model.Father != null)
            {
                <a asp-action="ViewChicken" asp-route-id="@Model.Father.Id">
                    @Model.Father.Legband_Id
                </a>
            }
            else
            {
                <span>Unknown</span>
            }
            </td>
        </tr>
        <tr>
            <th>Offspring</th>
            <td>
                <div style="max-height: 120px; overflow-y: auto;">
                    @if ((Model.ChildrenAsMother != null && Model.ChildrenAsMother.Any()) ||
                                        (Model.ChildrenAsFather != null && Model.ChildrenAsFather.Any()))
                    {
                        @if (Model.ChildrenAsMother != null)
                        {
                            foreach (var child in Model.ChildrenAsMother)
                            {
                                <div>
                                    <a asp-action="ViewChicken" asp-route-id="@child.Id">
                                        @child.Legband_Id
                                    </a>
                                </div>
                            }
                        }

                        @if (Model.ChildrenAsFather != null)
                        {
                            foreach (var child in Model.ChildrenAsFather)
                            {
                                <div>
                                    <a asp-action="ViewChicken" asp-route-id="@child.Id">
                                        @child.Legband_Id
                                    </a>
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <span>No known offspring</span>
                    }
                </div>
            </td>
        </tr>
    </table>
</div>