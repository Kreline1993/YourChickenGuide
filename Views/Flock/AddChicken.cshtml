@model YourChickenGuide.Models.Chicken
@{
    ViewData["Title"] = "Add Chicken";
}

<div class="details-shell">


    <div class="card card-surface border-0 shadow-sm p-4">
        <div class="text-center mb-3">
            <h1 class="display-6 mb-2 page-title">Add New Chicken</h1>
        </div>
        <form asp-action="AddNewChicken" method="post">
            @Html.AntiForgeryToken()

            <div class="row">
                <!-- Left column -->
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="Breed"></label>
                        <select id="Breed"
                                asp-for="Breed"
                                asp-items="@(new SelectList(ViewBag.Breeds ?? new List<string>()))"
                                class="form-control">
                            <option value="">Select Breed</option>
                        </select>
                        <span asp-validation-for="Breed" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="LegbandNumber">Legband Number</label>
                        <input asp-for="LegbandNumber" class="form-control" placeholder="00 0000" />
                        <span asp-validation-for="LegbandNumber" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Sex"></label>
                        <select asp-for="Sex" class="form-control">
                            <option value="">Select Sex</option>
                            <option value="Female">Female</option>
                            <option value="Male">Male</option>
                            <option value="Unknown">Unknown</option>
                        </select>
                        <span asp-validation-for="Sex" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="HatchDate"></label>
                        <input asp-for="HatchDate" class="form-control" type="date"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="HatchDate" class="text-danger"></span>
                    </div>
                </div>

                <!-- Right column -->
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="mother_Id">Mother</label>
                        <select id="MotherId" asp-for="mother_Id" class="form-control">
                            <option value="">Unknown</option>
                        </select>
                        <span asp-validation-for="mother_Id" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="father_Id">Father</label>
                        <select id="FatherId" asp-for="father_Id" class="form-control">
                            <option value="">Unknown</option>
                        </select>
                        <span asp-validation-for="father_Id" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Status"></label>
                        <select asp-for="Status"
                                asp-items="@(new SelectList(ViewBag.Statuses ?? new List<string>()))"
                                class="form-control">
                            <option value="">Status</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Color"></label>
                        <input asp-for="Color" class="form-control" />
                        <span asp-validation-for="Color" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Full-width -->
            <div class="form-group mt-4 text-center">
                <div class="form-group mb-3">
                    <label asp-for="Notes"></label>
                    <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary px-5">Save</button>
                <a class="btn btn-secondary ms-2" asp-action="Overview" asp-controller="Flock">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            // When Breed changes, load candidates for parents
            $("#Breed").on("change", function () {
                var breed = $(this).val();

                // Mothers
                $.getJSON('/Flock/GetParentsByBreed', { breed: breed, sex: "Female" }, function (data) {
                    var motherSelect = $("#MotherId");
                    motherSelect.empty().append($('<option>', { value: "", text: "Unknown" }));
                    $.each(data, function (i, chicken) {
                        motherSelect.append($('<option>', { value: chicken.id, text: chicken.legband_Id }));
                    });
                });

                // Fathers
                $.getJSON('/Flock/GetParentsByBreed', { breed: breed, sex: "Male" }, function (data) {
                    var fatherSelect = $("#FatherId");
                    fatherSelect.empty().append($('<option>', { value: "", text: "Unknown" }));
                    $.each(data, function (i, chicken) {
                        fatherSelect.append($('<option>', { value: chicken.id, text: chicken.legband_Id }));
                    });
                });
            });
        })();
    </script>
}
