@model YourChickenGuide.Models.Chicken
@{
    ViewData["Title"] = "Add Chicken";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - YourChickenGuide</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/YourChickenGuide.styles.css" asp-append-version="true" />
</head>
<body>
<div class="text-center">
        <div class="w-50 mx-auto bg-lightslategray p-4 rounded shadow">
        <h1>Add New Chicken</h1>

    <form asp-action="AddNewChicken" method="post">
        <div class="form-group mb-3">
            <label asp-for="Breed"></label>
            <select asp-for="Breed" asp-items="@(new SelectList(ViewBag.Breeds ?? new List<string>()))"class="form-control"></select> 
        </div>

                <div class="form-group mb-3">
            <label asp-for="LegbandNumber"></label>
            <input asp-for="LegbandNumber" class="form-control"/>
        </div>
                <div class="form-group mb-3">
            <label asp-for="Sex"></label>
            <input type="radio" asp-for="Sex" value="Female"  /> Female
            <input type="radio" asp-for="Sex" value="Male"  /> Male
            <input type="radio" asp-for="Sex" value="Unknown"  /> Unknown
        </div>
                <div class="form-group mb-3">
            <label asp-for="HatchDate"></label>
            <input asp-for="HatchDate" class="form-control" type="date"
                   value="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </div>
                <div class="form-group mb-3">
            <label asp-for="Color"></label>
            <input asp-for="Color" class="form-control" />
        </div>
                <div class="form-group mb-3">
            <label asp-for="Notes"></label>
            <textarea asp-for="Notes" class="form-control"></textarea>
        </div>

                <div class="form-group mb-3">
            <label asp-for="Status"></label>
            <select asp-for="Status" asp-items="@(new SelectList(ViewBag.Statuses ?? new List<string>()))" class="form-control"></select>
        </div>
                <div class="form-group mb-3">
            <button type="submit" class="btn btn-primary">Save</button>
        </div>


                </form>
            </div>
</div>

</body>
</html>